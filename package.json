{
  "name": "ski",
  "version": "1.0.1",
  "private": true,
  "description": "Ski Extension — Skip YouTube ads with a keypress. Free, open-source browser extension.",
  "author": "Winter Jackson",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,html,css,json,md}\"",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.27.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.7",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
